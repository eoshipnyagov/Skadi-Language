import "./sensor.skd"

new i16 raw_value = 412
new i16 offset = -12
new i32 calibrated = 0
calibrated = sensor.sensor_calibrate(raw_value, offset) on error {
    output("Calibration failed")
}
new Bool valid = sensor.sensor_is_valid(calibrated)
new sensor.SensorReading reading = sensor.sensor_describe(calibrated)
new u8 List packet = [10, 20, 30]
new u32 checksum_before = sensor.sensor_checksum(view packet)
sensor.sensor_adjust(edit packet, 1) on error {
    output("Packet adjustment failed")
}
new u32 checksum_after = sensor.sensor_checksum(view packet)
fn demonstrate_handle(i32 initial_value) returns i32 {
    new sensor.Sensor handle = sensor.sensor_open(initial_value) on error {
        output("Handle allocation failed")
        return -1
    }
    new i32 handle_before = sensor.sensor_handle_read(view handle)
    sensor.sensor_handle_adjust(edit handle, 5) on error {
        output("Handle adjustment failed")
    }
    new i32 handle_after = sensor.sensor_handle_read(view handle)
    sensor.sensor_close(move handle) on error {
        output("Handle close failed")
    }
    output("Opaque handle value: ", handle_before, " -> ", handle_after)
    return 0
}

demonstrate_handle(calibrated)

output("Calibrated reading: ", calibrated)
output("Reading valid: ", valid)
output("Reading confidence: ", reading.confidence)
output("Packet checksum: ", checksum_before, " -> ", checksum_after)
