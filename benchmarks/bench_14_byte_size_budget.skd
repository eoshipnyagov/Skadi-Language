fn calculate_capacity(ByteSize payload) returns ByteSize {
    return payload + 1kb
}

new ByteSize payload = 2kb
new ByteSize capacity = calculate_capacity(payload)
new ByteSize archive_limit = 1tb
new ByteSize archive_half = archive_limit / 2
new Float archive_ratio = archive_half / archive_limit
new ByteSize List checkpoints = [payload, capacity]
new Int checkpoint_count = 0

iterate checkpoints as checkpoint {
    if checkpoint >= payload {
        checkpoint_count++
    }
}

Memory buffer_memory = memory(capacity) on error {
    output("byte budget rejected")
}

place in buffer_memory {
    new Text message = concat("ByteSize", " budget ready")
    output(message)
} on error {
    output("byte budget overflow")
}

new Bool exact_capacity = capacity == 3kb
output(exact_capacity)
output(checkpoint_count)
output("archive half bytes: ", as_bytes(archive_half))
output("archive ratio: ", archive_ratio)
buffer_memory.clear()
